          <mx:Label id="custom-lesson-status" x="210" y="272" width="234" height="20" boxHeight="52" text="Temporary lessons disappear when the app reloads." color="#8C82A4"/>
        </mx:Sprite>
        <mx:Button id="library-previous" x="670" y="648" width="94" height="36" label="Previous" ariaLabel="Previous library page" backgroundColor="#F1EFF8" borderColor="#E5DFF1" color="#8476A4" cornerRadius="9"/>
        <mx:Label id="library-page-label" x="817" y="656" height="20" text="Page 1 of 1" color="#8A96A9"/>
        <mx:Button id="library-next" x="1020" y="648" width="94" height="36" label="Next" ariaLabel="Next library page" backgroundColor="#F1EFF8" borderColor="#E5DFF1" color="#8476A4" cornerRadius="9"/>
        <mx:Label id="library-notice" x="670" y="693" width="444" height="20" boxHeight="38" text="Choose a song, then practice or use Auto play." color="#8C82A4"/>
      </mx:Sprite>
      <mx:Sprite id="settings-panel" visible="false">
        <mx:Label x="484" y="214" height="20" text="YOUR PRACTICE, YOUR PACE" color="#8D83B2" fontWeight="600"/>
        <mx:Label x="484" y="249" height="43" text="Find your comfort zone." color="#344158" fontWeight="700"/>
        <mx:Label x="484" y="338" height="25" text="Piano volume" color="#59677C" fontWeight="600"/>
        <mx:Label x="484" y="367" height="20" text="Also adjusts the metronome" color="#99A4B5"/>
        <mx:Button id="volume-minus" x="927" y="334" width="43" height="40" label="-" ariaLabel="Lower volume" backgroundColor="#F0F2F7" borderColor="#E4E9F0" cornerRadius="9"/>
        <mx:Label id="volume-label" x="989" y="344" height="23" text="70%" color="#758196"/>
        <mx:Button id="volume-plus" x="1068" y="334" width="43" height="40" label="+" ariaLabel="Raise volume" backgroundColor="#F0F2F7" borderColor="#E4E9F0" cornerRadius="9"/>
        <mx:Rect x="484" y="397" width="628" height="1" fill="#EDF0F5"/>
        <mx:Label x="484" y="415" height="25" text="Metronome" color="#59677C" fontWeight="600"/>
        <mx:Label x="484" y="444" height="20" text="A steady beat in Play along and Listen" color="#99A4B5"/>
        <mx:Sprite id="metronome-control" x="1022" y="411"><mx:Button width="90" height="40" ariaLabel="Toggle metronome" backgroundColor="#F0EDF9" borderColor="#E5DEF3" cornerRadius="20"/><mx:Label id="metronome-label" x="31" y="9" height="22" text="Off" color="#8F80B8"/></mx:Sprite>
        <mx:Rect x="484" y="476" width="628" height="1" fill="#EDF0F5"/>
        <mx:Label x="484" y="495" height="25" text="Practice instructions" color="#59677C" fontWeight="600"/>
        <mx:Label x="484" y="524" height="20" text="Show which note and keyboard key to play" color="#99A4B5"/>
        <mx:Sprite id="instructions-control" x="1022" y="491"><mx:Button width="90" height="40" ariaLabel="Toggle practice instructions" backgroundColor="#F0EDF9" borderColor="#E5DEF3" cornerRadius="20"/><mx:Label id="instructions-label" x="31" y="9" height="22" text="On" color="#8F80B8"/></mx:Sprite>
        <mx:Rect x="484" y="556" width="628" height="1" fill="#EDF0F5"/>
        <mx:Label x="484" y="575" height="25" text="Note names &amp; keyboard shortcuts" color="#59677C" fontWeight="600"/>
        <mx:Sprite id="labels-control" x="1022" y="571"><mx:Button width="90" height="40" ariaLabel="Toggle key labels" backgroundColor="#F0EDF9" borderColor="#E5DEF3" cornerRadius="20"/><mx:Label id="labels-label" x="31" y="9" height="22" text="On" color="#8F80B8"/></mx:Sprite>
        <mx:Rect x="484" y="636" width="628" height="1" fill="#EDF0F5"/>
        <mx:Label x="484" y="655" height="25" text="Finger numbers" color="#59677C" fontWeight="600"/>
        <mx:Sprite id="fingers-control" x="1022" y="651"><mx:Button width="90" height="40" ariaLabel="Toggle finger numbers" backgroundColor="#F0EDF9" borderColor="#E5DEF3" cornerRadius="20"/><mx:Label id="fingers-label" x="31" y="9" height="22" text="On" color="#8F80B8"/></mx:Sprite>
        <mx:Label x="586" y="698" height="20" text="Your lesson pauses while you make yourself at home." color="#A2ABBA"/>
      </mx:Sprite>
      <mx:Sprite id="help-panel" visible="false">
        <mx:Label x="484" y="214" height="20" text="EVERY PIANIST STARTS SOMEWHERE" color="#8D83B2" fontWeight="600"/>
        <mx:Label x="484" y="249" height="43" text="One note at a time." color="#344158" fontWeight="700"/>
        <mx:Label x="484" y="324" height="25" text="1. Find the highlighted key." color="#647286" fontWeight="600"/>
        <mx:Label x="511" y="358" height="22" text="Click or touch a piano key. Its color matches the note above." color="#8A96A9"/>
        <mx:Label x="484" y="405" height="25" text="2. Let your keyboard become a piano." color="#647286" fontWeight="600"/>
        <mx:Label x="511" y="440" height="22" text="White keys: A S D F G H J K L ;  =  C4 D4 E4 F4 G4 A4 B4 C5 D5 E5" color="#8A96A9"/>
        <mx:Label x="511" y="473" height="22" text="Black keys: W E T Y U O P.  Hold several keys to play a chord." color="#8A96A9"/>
        <mx:Label x="484" y="520" height="25" text="3. Practice your way." color="#647286" fontWeight="600"/>
        <mx:Label x="511" y="555" height="22" text="Wait for me pauses at each note. Play along keeps the beat." color="#8A96A9"/>
        <mx:Label x="511" y="588" height="22" text="Auto play demos the melody. Follow the keys, then try it yourself." color="#8A96A9"/>
        <mx:Rect x="484" y="642" width="628" height="57" fill="#F4F3FA" radiusTopLeft="12" radiusTopRight="12" radiusBottomLeft="12" radiusBottomRight="12"/>
        <mx:Label x="536" y="660" height="22" text="SPACE  Play / pause       ESC  Close dialog       1-5  Finger numbers" color="#9487B2"/>
      </mx:Sprite>
      <mx:Sprite id="result-panel" visible="false">
        <mx:Rect x="751" y="219" width="96" height="96" fill="#E8F5EF" radiusTopLeft="48" radiusTopRight="48" radiusBottomLeft="48" radiusBottomRight="48"/>
        <mx:Path d="M 774 263 L 792 281 L 826 246" fill="" stroke="#6FAD92" strokeWidth="5" strokeLinecap="round" strokeLinejoin="round"/>
        <mx:Label id="result-title" x="549" y="348" height="40" text="A little better. Every note." color="#46576B" fontWeight="700"/>
        <mx:Label id="result-detail" x="562" y="401" height="23" text="You played every note." color="#99A4B3"/>
        <mx:Rect x="524" y="458" width="249" height="112" fill="#F4F3FA" radiusTopLeft="16" radiusTopRight="16" radiusBottomLeft="16" radiusBottomRight="16"/>
        <mx:Rect x="801" y="458" width="274" height="112" fill="#F0F7F3" radiusTopLeft="16" radiusTopRight="16" radiusBottomLeft="16" radiusBottomRight="16"/>
        <mx:Label x="548" y="475" height="20" text="POINTS EARNED" color="#A296BC"/>
        <mx:Label id="result-score" x="548" y="503" height="49" text="0" color="#7C6D9F" fontWeight="700"/>
        <mx:Label x="828" y="475" height="20" text="ACCURACY" color="#91AC9E"/>
        <mx:Label id="result-accuracy" x="828" y="503" height="49" text="100%" color="#749784" fontWeight="700"/>
        <mx:Button id="practice-again" x="524" y="610" width="249" height="50" label="Practice again" ariaLabel="Practice again in Wait for me mode" backgroundColor="#8980B2" borderColor="#8980B2" color="#FFFFFF" cornerRadius="12"/>
        <mx:Button id="next-lesson" x="801" y="610" width="274" height="50" label="Explore the lessons" ariaLabel="Choose another lesson" backgroundColor="#F1F3F8" borderColor="#E2E7EF" color="#7A899D" cornerRadius="12"/>
        <mx:Label x="612" y="697" height="20" text="Progress isn't perfect. It's showing up." color="#A2ABBA"/>
      </mx:Sprite>
    </mx:Sprite>
  </mx:Layer>

